# Copy to .env (optional: every value below is also the built-in default).
# Loaded by api, mock-providers, web (Vite proxy) and scripts/demo.ts.

API_PORT=3000
MOCK_PROVIDERS_PORT=4000
WEB_PORT=5173

# API -> mock providers, and mock providers -> API webhook.
PROVIDER_BASE_URL=http://localhost:4000
WEBHOOK_URL=http://localhost:3000/webhooks/provider

# HMAC-SHA256 secret shared by the mock providers (signing) and the API
# (verifying callbacks). Dev value only: set your own, never commit a real one.
HMAC_SECRET=dev-only-hmac-secret-change-me

# SQLite file, relative to api/ (npm workspaces run the API from api/).
DB_PATH=./data/app.db
UPLOAD_DIR=./uploads
OCR_CACHE_DIR=./.ocr-cache

# Demo timings (30s verification timeout, 1s backoff base) and /admin/reset-data.
DEMO_MODE=true

CONFIDENCE_THRESHOLD=0.8
NAME_MATCH_THRESHOLD=0.85
RISK_THRESHOLD=70
BLUR_THRESHOLD=30

LOG_LEVEL=info
