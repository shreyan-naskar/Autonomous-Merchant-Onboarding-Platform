{
  "name": "autonomous-merchant-onboarding-platform",
  "version": "1.0.0",
  "description": "An onboarding workflow that receives a merchant application, extracts and validates information, coordinates simulated verification systems, manages exceptions and progresses an eligible application to an approved state.",
  "main": "index.js",
  "workspaces": [
    "api",
    "mock-providers",
    "web",
    "shared"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev": "concurrently \"npm run dev -w api\" \"npm run dev -w mock-providers\" \"npm run dev -w web\"",
    "demo": "tsx scripts/demo.ts",
    "build": "npm run build --workspaces --if-present"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shreyan-naskar/Autonomous-Merchant-Onboarding-Platform.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/shreyan-naskar/Autonomous-Merchant-Onboarding-Platform/issues"
  },
  "homepage": "https://github.com/shreyan-naskar/Autonomous-Merchant-Onboarding-Platform#readme",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "jsdom": "^31.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "better-sqlite3@13.2.0": true
  }
}
